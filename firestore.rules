// GreenShot — Regras de segurança do Firestore
// ================================================
// Como usar: Console do Firebase → Firestore Database → aba "Regras" →
// cole todo este conteúdo no lugar do que já estiver lá → "Publicar".
//
// O que isso garante: cada pessoa só consegue ler e escrever o PRÓPRIO
// documento de progresso (users/{userId}, onde userId é o UID dela no
// Firebase Authentication) — nunca o de outra pessoa, mesmo estando
// autenticada.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Por padrão, nega tudo que não foi explicitamente liberado acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
